{
  "name": "bcaway-notifications",
  "version": "1.0.0",
  "description": "Cloudflare Worker for BCAway Push Notifications",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:init": "wrangler d1 execute bcaway-notifications --file=./schema.sql --remote",
    "d1:init:local": "wrangler d1 execute bcaway-notifications --file=./schema.sql --local"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "typescript": "^5.7.3",
    "wrangler": "^4.136.0"
  },
  "private": true
}
